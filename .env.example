# Copy to .env (git-ignored). No secrets here: this is the local dev database.
DATABASE_URL=postgresql://jobfacts:jobfacts@localhost:5433/jobfacts

# API keys for extraction (never commit real values):
# TYPESAFE_API_KEY=     # Jev, the extractor used for search
# OPENROUTER_API_KEY=   # Jev backup route and model comparisons
# DEEPSEEK_API_KEY=     # optional, model comparison only

# --- Server only (docs/deploy.md; `deploy/setup.sh` fills these in on the server) ---------
# The server's .env is its own file: the DATABASE_URL above is ignored there, because
# deploy/compose.prod.yml builds the URL from POSTGRES_PASSWORD. Use letters and digits only
# in POSTGRES_PASSWORD (it goes into a URL).
POSTGRES_PASSWORD=
# A long password for the search page and API (HTTP Basic, any user name):
JOBFACTS_WEB_PASSWORD=
# The web address Caddy gets a certificate for, e.g. 203-0-113-7.sslip.io or a real domain:
JOBFACTS_DOMAIN=
# The Mistral key is used for the meaning search and the daily embeddings:
MISTRAL_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Dead-man switch: the ping URL of a healthchecks.io check (docs/monitoring.md). `jobfacts
# daily` pings it at start, on success and on failure. Empty = no pings. It is a secret.
JOBFACTS_HEALTHCHECK_URL=
